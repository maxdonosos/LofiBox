<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Lo-Fi Box @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plug-in" description="/Library/Audio/Plug-Ins/VST3">
        <pkg-ref id="com.superserius.lofibox.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (Logic, GarageBand...)" description="/Library/Audio/Plug-Ins/Components">
        <pkg-ref id="com.superserius.lofibox.au"/>
    </choice>
    <choice id="app" title="Standalone app" description="/Applications">
        <pkg-ref id="com.superserius.lofibox.app"/>
    </choice>

    <pkg-ref id="com.superserius.lofibox.vst3" version="@VERSION@">vst3.pkg</pkg-ref>
    <pkg-ref id="com.superserius.lofibox.au"   version="@VERSION@">au.pkg</pkg-ref>
    <pkg-ref id="com.superserius.lofibox.app"  version="@VERSION@">app.pkg</pkg-ref>
</installer-gui-script>
